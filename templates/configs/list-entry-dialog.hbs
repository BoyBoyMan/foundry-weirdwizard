<form>

  {{!-- New Key --}}
  {{#if showKey}}
  <div class="stat-inline">
    <label>{{localize "WW.Settings.Entry.Key"}}:</label>
    <input name="key" type="text" value="{{key}}" required />
  </div>
  {{/if}}
  
  {{!-- Name --}}
  <div class="stat-inline">
    <label>{{localize "WW.Settings.Entry.Name"}}:</label>
    <input name="name" type="text" value="{{localize entry.name}}" required />
  </div>

  {{!-- Description --}}
  <div class="stat">
    <label>{{localize "WW.Settings.Entry.Description"}}:</label>

    <textarea name="desc">{{entry.desc}}</textarea>
  </div>

  {{!-- Changes (afflictions only) --}}
  {{#if showChanges}}
  <div class="stat changes-wrapper">
    <ol class="item-list changes-list">
  
      {{!-- Header Row --}}
      <li class="item items-header flexrow">
        <div class="item-name">{{localize "WW.Effect.Changes"}}</div>
        <div class="item-controls effect-controls flexrow">
          <a class="effect-control" data-action="changeCreate" data-tooltip="WW.Effect.Create">
            <i class="fa-solid fa-plus"></i> {{localize "WW.Item.Create.Label"}}
          </a>
        </div>
      </li>
  
      {{!-- Change Rows --}}
      {{#each entry.changes as |change i|}}
      {{log change}}
      <li class="item change flexrow" data-change-index="{{i}}">
        <div class="item-name">{{localize (lookup change "preset")}}</div>
  
        <div class="item-controls effect-controls flexrow">
          <a class="effect-control" data-action="changeEdit" data-change-index="{{i}}" data-tooltip="WW.Effect.Edit">
            <i class="fa-solid fa-edit"></i>
          </a>
          <a class="effect-control" data-action="changeRemove" data-change-index="{{i}}" data-tooltip="WW.Effect.Remove">
            <i class="fa-solid fa-trash"></i>
          </a>
        </div>
      </li>
      {{/each}}

    </ol>
  </div>
  {{/if}}
  
  {{!-- Granted By --}}
  {{#if entry.grantedBy}}
  <div class="stat-inline">
    <label>{{localize "WW.CharOption.GrantedBy"}}:</label>
    {{{grantedBy}}}
  </div>
  {{/if}}
  
</form>